# Application settings
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# Database settings
# Use PostgreSQL with pgvector in production, default to local SQLite for fallback testing
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sales_copilot
# Fallback SQLite URL for local testing without PostgreSQL
DATABASE_SQLITE_URL=sqlite:///./sales_copilot.db

# Redis settings
REDIS_URL=redis://localhost:6379/0

# Compliance & Security
# Generate key via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=3J3V5eT3k7z2b8d9V6c7X8z9y0A1B2C3D4E5F6G7H8I=

# Provider configurations (set to 'mock' or 'real')
STT_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock

# External API Keys (Required when provider is 'real')
GEMINI_API_KEY=your_gemini_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# LLM configurations
GEMINI_MODEL=gemini-2.5-flash
WHISPER_MODEL=base
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
