# Shared local-development template. Copy to .env and replace placeholders.
APP_ENV=development
LOG_LEVEL=INFO

# Core SQLAlchemy API (run from backend/ on port 8000)
PORT=8000
USE_SQLITE=true
DATABASE_SQLITE_URL=sqlite:///./sales_copilot.db
AUTH_REQUIRED=false
JWT_SECRET=
JWT_ACCESS_MINUTES=60
INTERNAL_API_KEY=

# AI co-pilot API (run from repository root on port 8001)
APP_PORT=8001
CORE_API_URL=http://127.0.0.1:8000
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=en
TRANSCRIPTION_WINDOW_SECONDS=12
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION=pay_in_3_knowledge
RAG_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.48
